# Backend Environment Variables
# Copy this file to .env and configure for your deployment

# Required for Supabase PostgreSQL persistence
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://ptvbzulpmllsweidyqie.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Not used by backend code (only needed if frontend uses Supabase directly)
# SUPABASE_ANON_KEY=your-anon-key-here

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# CORS - comma-separated origins allowed to call the API
# Must include your Vercel frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app