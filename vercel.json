{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd frontend && pnpm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && pnpm install",
  "devCommand": "cd frontend && pnpm dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://campusflow-api.onrender.com/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
